{
  "name": "post-express-premium",
  "version": "1.0.0",
  "description": "Post Express Premium — La Poste Côte d'Ivoire BUELT",
  "main": "main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node backend/server.js",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "adm-zip": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jspdf": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "node-unrar-js": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "winston": "^3.12.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ci.laposte.surtaxe-dhl",
    "productName": "Post Express Premium",
    "copyright": "La Poste Côte d'Ivoire",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/static/icon.png"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Post Express Premium"
    },
    "files": [
      "main.js",
      "preload.js",
      ".env",
      "backend/**/*",
      "frontend/**/*",
      "generated/.gitkeep",
      "logs/.gitkeep",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "generated",
        "to": "generated"
      },
      {
        "from": "logs",
        "to": "logs"
      }
    ]
  }
}
